# Build cache & speed config for VAC workspace.
# Scope: applies only when cargo is run inside this repo (or its worktrees).

[build]
# Shared target dir across all worktrees + agents working on this repo.
# Prevents 50GB/worktree duplication; agents reuse each other's compiled deps.
target-dir = "/home/emp/.cargo-target-shared/vastar-agentic-cli"

# sccache wraps rustc with a global compile cache — even `cargo clean` +
# rebuild reuses work from any prior build (stored in ~/.cache/sccache).
rustc-wrapper = "sccache"

# Leave ~2 cores for editor/agent responsiveness on i7-8750H (12 threads).
jobs = 10

[profile.dev]
# "line-tables-only" keeps backtraces usable but cuts debug-info size ~70%
# and shaves measurable time off link step. Switch to 0 if you never debug.
debug = "line-tables-only"
incremental = true
# More codegen units = more parallelism, slightly worse runtime (fine for dev).
codegen-units = 256

[profile.dev.package."*"]
# Dependencies rarely need debug info. Stripping it here is the single biggest
# win for this workspace given the LLM/RAG dep graph.
debug = false

# --- Faster linker (mold 1.0.3 + clang 14 installed) ---
# Link time on workspaces with many rlibs (vil_llm, vil_rag, ...) drops 30-50%.

[target.x86_64-unknown-linux-gnu]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
